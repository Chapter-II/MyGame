# Local machine secrets (copy to local.env, never commit)

# DeepSeek text command parsing + optional online speech (preferred)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional Whisper-compatible model name if the gateway exposes ASR
# DEEPSEEK_SPEECH_MODEL=whisper-1

# Dedicated online ASR (OpenAI-compatible). Overrides DeepSeek for speech if set.
SPEECH_API_KEY=
SPEECH_API_URL=https://api.openai.com/v1
SPEECH_API_MODEL=whisper-1
SPEECH_API_LANG=zh
