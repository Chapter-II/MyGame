# 本机密钥配置（已加入 .gitignore，请勿提交）
# 复制为 local.env 后填入真实值；启动脚本会自动加载。

# DeepSeek 文字军令解析（可选，离线规则解析仍可用）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 在线语音识别（可选，OpenAI 兼容）
SPEECH_API_KEY=
SPEECH_API_URL=https://api.openai.com/v1
SPEECH_API_MODEL=whisper-1
SPEECH_API_LANG=zh
